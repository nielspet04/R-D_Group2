[
  {
    "index": 6,
    "title": "DERM learns two Exo targets",
    "speaker": "Niels",
    "seconds": 85,
    "notes": "Video-level target averages MAE CLS features across the aligned past-plus-future window. Frame-level targets are individual MAE CLS features for the future chunk. Decoded Ego-conditioned queries regress these targets with MSE. The global vector summarizes motion across the clip, while the frame sequence preserves local spatial detail. For asynchronous EgoMe videos, linear relative-time alignment is used. This alignment can be imperfect.",
    "source": "§3.3, Eqs.10–15",
