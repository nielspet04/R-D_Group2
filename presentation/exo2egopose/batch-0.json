[{"index": 0, "title": "Exo2EgoPose", "speaker": "Niels", "seconds": 35, "notes": "Open with the question: can a third-person demonstration teach a first-person model what its hands will do next? Introduce Emiel and yourself. This is Shi et al., ACM Multimedia 2026, not our own method. Preview task, mechanism, evidence and critique.", "source": "p.1", "el": [{"type": "text", "v": "01", "x": 1168, "y": 668, "w": 65, "h": 28, "size": 18, "color": "#72787C", "bold": false}, {"type": "img", "name": "extracted-2-16", "x": 660, "y": 0, "w": 620, "h": 720, "fit": "cover"}, {"type": "text", "v": "Exo2\nEgoPose", "x": 64, "y": 145, "w": 590, "h": 245, "size": 108, "color": "#171B1E", "bold": true}, {"type": "text", "v": "Forecasting 3D hand poses\nwith guidance from another view", "x": 68, "y": 436, "w": 550, "h": 110, "size": 32, "color": "#72787C", "bold": false}, {"type": "text", "v": "Niels Peters & Emiel Digneffe", "x": 68, "y": 601, "w": 570, "h": 38, "size": 25, "color": "#171B1E", "bold": true}, {"type": "text", "v": "HCVISION \u00b7 Shi et al., ACM MM 2026", "x": 68, "y": 650, "w": 570, "h": 30, "size": 20, "color": "#72787C", "bold": false}]}, {"index": 1, "title": "What the Ego camera misses", "speaker": "Niels", "seconds": 55, "notes": "Ego cameras see what is in front of the wearer, so hands and objects may be truncated. Head motion changes the background. Exo demonstrations offer complementary context. Stable and holistic is the paper\u2019s motivation, not a guarantee for every capture. Use the real paired images to explain this.", "source": "Fig.1, pp.1\u20132", "el": [{"type": "text", "v": "What the Ego camera misses", "x": 64, "y": 57, "w": 1150, "h": 110, "size": 50, "color": "#171B1E", "bold": true}, {"type": "text", "v": "02", "x": 1168, "y": 668, "w": 65, "h": 28, "size": 18, "color": "#72787C", "bold": false}, {"type": "text", "v": "Fig.1, pp.1\u20132", "x": 64, "y": 670, "w": 1060, "h": 25, "size": 15, "color": "#72787C", "bold": false}, {"type": "img", "name": "extracted-2-0", "x": 64, "y": 205, "w": 540, "h": 330, "fit": "contain"}, {"type": "img", "name": "extracted-2-19", "x": 676, "y": 205, "w": 540, "h": 330, "fit": "contain"}, {"type": "text", "v": "Ego", "x": 64, "y": 550, "w": 540, "h": 45, "size": 34, "color": "#171B1E", "bold": true}, {"type": "text", "v": "Exo", "x": 676, "y": 550, "w": 540, "h": 45, "size": 34, "color": "#171B1E", "bold": true}, {"type": "text", "v": "Close to the action. Partial and moving.", "x": 64, "y": 603, "w": 540, "h": 60, "size": 25, "color": "#72787C", "bold": false}, {"type": "text", "v": "A wider view of the same activity.", "x": 676, "y": 603, "w": 540, "h": 60, "size": 25, "color": "#72787C", "bold": false}]}, {"index": 2, "title": "The forecasting task", "speaker": "Niels", "seconds": 65, "notes": "Inputs are past Ego RGB, a language instruction and past 3D hand poses. Output is ten future frames of 42 3D joints and joint validity. Coordinates are in the Ego camera system. Forecasting is different from estimating the current pose. Ten frames correspond to about 0.67 seconds at 15 fps and 0.33 seconds at 30 fps. Past pose availability is a deployment assumption.", "source": "\u00a73.1, \u00a74.1.3", "el": [{"type": "text", "v": "The forecasting task", "x": 64, "y": 57, "w": 1150, "h": 110, "size": 50, "color": "#171B1E", "bold": true}, {"type": "text", "v": "03", "x": 1168, "y": 668, "w": 65, "h": 28, "size": 18, "color": "#72787C", "bold": false}, {"type": "text", "v": "\u00a73.1, \u00a74.1.3", "x": 64, "y": 670, "w": 1060, "h": 25, "size": 15, "color": "#72787C", "bold": false}, {"type": "text", "v": "Observe", "x": 64, "y": 220, "w": 340, "h": 46, "size": 31, "color": "#72787C", "bold": false}, {"type": "text", "v": "Condition", "x": 472, "y": 220, "w": 340, "h": 46, "size": 31, "color": "#72787C", "bold": false}, {"type": "text", "v": "Forecast", "x": 880, "y": 220, "w": 340, "h": 46, "size": 31, "color": "#72787C", "bold": false}, {"type": "text", "v": "Past Ego RGB\nand 3D poses", "x": 64, "y": 300, "w": 350, "h": 125, "size": 46, "color": "#171B1E", "bold": true}, {"type": "text", "v": "A language\ninstruction", "x": 472, "y": 300, "w": 350, "h": 125, "size": 46, "color": "#171B1E", "bold": true}, {"type": "text", "v": "10 future\nhand poses", "x": 880, "y": 300, "w": 350, "h": 125, "size": 46, "color": "#2D5263", "bold": true}, {"type": "arrow", "x": 413, "y": 340, "w": 35, "h": 22, "color": "#2D5263"}, {"type": "arrow", "x": 821, "y": 340, "w": 35, "h": 22, "color": "#2D5263"}, {"type": "box", "x": 64, "y": 492, "w": 1152, "h": 1, "color": "#D9DDDF"}, {"type": "text", "v": "42 joints", "x": 64, "y": 535, "w": 360, "h": 63, "size": 48, "color": "#171B1E", "bold": true}, {"type": "text", "v": "3D + validity", "x": 472, "y": 535, "w": 360, "h": 63, "size": 48, "color": "#171B1E", "bold": true}, {"type": "text", "v": "0.33\u20130.67 s", "x": 880, "y": 535, "w": 360, "h": 63, "size": 48, "color": "#171B1E", "bold": true}, {"type": "text", "v": "Two hands, 21 joints each", "x": 64, "y": 610, "w": 360, "h": 32, "size": 22, "color": "#72787C", "bold": false}, {"type": "text", "v": "Ego camera coordinates", "x": 472, "y": 610, "w": 360, "h": 32, "size": 22, "color": "#72787C", "bold": false}, {"type": "text", "v": "10 frames at 30 / 15 fps", "x": 880, "y": 610, "w": 360, "h": 32, "size": 22, "color": "#72787C", "bold": false}]}, {"index": 3, "title": "Where the paper fits", "speaker": "Niels", "seconds": 65, "notes": "USST forecasts coarse 3D hand trajectories; OCT and MADiff are other motion forecasting precedents. MCIL and HULC condition robot policies on language. GR-1 learns through human video pretraining. AR-VRM uses hand-keypoint pretraining and analogical reasoning. Exo2EgoPose combines joint-level forecasting with training-time Exo feature supervision. Baselines here are adapted, not verbatim published results.", "source": "\u00a72; Appendix A", "el": [{"type": "text", "v": "Where the paper fits", "x": 64, "y": 57, "w": 1150, "h": 110, "size": 50, "color": "#171B1E", "bold": true}, {"type": "text", "v": "04", "x": 1168, "y": 668, "w": 65, "h": 28, "size": 18, "color": "#72787C", "bold": false}, {"type": "text", "v": "\u00a72; Appendix A", "x": 64, "y": 670, "w": 1060, "h": 25, "size": 15, "color": "#72787C", "bold": false}, {"type": "table", "rows": [["Research line", "Representative methods", "Remaining gap"], ["Hand motion forecasting", "OCT \u00b7 USST \u00b7 MADiff", "Mostly coarse motion"], ["Language-conditioned control", "MCIL \u00b7 HULC", "Robot data and embodiment"], ["Human-to-robot pretraining", "GR-1 \u00b7 AR-VRM", "Limited Ego context"], ["Exo2EgoPose", "Joint-level multimodal forecasting", "Exo supervision at two levels"]], "x": 68, "y": 202, "w": 1140, "h": 350, "widths": [320, 420, 400]}, {"type": "text", "v": "Contribution: learn Exo context, then use it to refine Ego pose features", "x": 68, "y": 590, "w": 1120, "h": 60, "size": 30, "color": "#2D5263", "bold": true}]}, {"index": 4, "title": "The forecasting pipeline", "speaker": "Niels", "seconds": 70, "notes": "Walk left to right. Encoders produce tokens, the causal transformer decodes pose and Exo queries, DERM learns two Exo representations, and GLMM refines pose features. Actual Exo video supplies feature targets during training only. At test time those features are predicted from the available Ego inputs. Reconstruction refers to feature vectors, not photorealistic Exo video.", "source": "Fig.2; \u00a73", "el": [{"type": "text", "v": "The forecasting pipeline", "x": 64, "y": 57, "w": 1150, "h": 110, "size": 50, "color": "#171B1E", "bold": true}, {"type": "text", "v": "05", "x": 1168, "y": 668, "w": 65, "h": 28, "size": 18, "color": "#72787C", "bold": false}, {"type": "text", "v": "Fig.2; \u00a73", "x": 64, "y": 670, "w": 1060, "h": 25, "size": 15, "color": "#72787C", "bold": false}, {"type": "text", "v": "Reconstruct Exo context from Ego inputs", "x": 64, "y": 198, "w": 1140, "h": 45, "size": 30, "color": "#72787C", "bold": false}, {"type": "box", "x": 64, "y": 278, "w": 240, "h": 118, "color": "#F0F2F2"}, {"type": "text", "v": "Multimodal\nEgo inputs", "x": 82, "y": 296, "w": 204, "h": 94, "size": 25, "color": "#171B1E", "bold": false}, {"type": "arrow", "x": 323, "y": 325, "w": 40, "h": 22, "color": "#2D5263"}, {"type": "box", "x": 384, "y": 278, "w": 240, "h": 118, "color": "#F0F2F2"}, {"type": "text", "v": "Causal\ntransformer", "x": 402, "y": 296, "w": 204, "h": 94, "size": 25, "color": "#171B1E", "bold": false}, {"type": "arrow", "x": 644, "y": 325, "w": 40, "h": 22, "color": "#2D5263"}, {"type": "box", "x": 704, "y": 278, "w": 240, "h": 118, "color": "#F0F2F2"}, {"type": "text", "v": "Predicted\nExo features", "x": 722, "y": 296, "w": 204, "h": 94, "size": 25, "color": "#171B1E", "bold": false}, {"type": "arrow", "x": 963, "y": 325, "w": 40, "h": 22, "color": "#2D5263"}, {"type": "box", "x": 1024, "y": 278, "w": 192, "h": 118, "color": "#F0F2F2"}, {"type": "text", "v": "GLMM +\npose head", "x": 1042, "y": 296, "w": 156, "h": 94, "size": 25, "color": "#171B1E", "bold": false}, {"type": "box", "x": 704, "y": 460, "w": 512, "h": 1, "color": "#D9DDDF"}, {"type": "text", "v": "Training supervision", "x": 704, "y": 490, "w": 500, "h": 39, "size": 25, "color": "#72787C", "bold": false}, {"type": "text", "v": "Paired Exo video supplies\nglobal and local feature targets", "x": 704, "y": 545, "w": 500, "h": 88, "size": 31, "color": "#171B1E", "bold": true}, {"type": "text", "v": "DERM reconstructs.\nGLMM modulates.", "x": 64, "y": 481, "w": 570, "h": 150, "size": 44, "color": "#171B1E", "bold": true}]}, {"index": 5, "title": "Multimodal tokens and queries", "speaker": "Niels", "seconds": 60, "notes": "CLIP text, frozen MAE and DINOv2 visual encoders, and trainable HandFormer for poses. Visual tokens are resampled from 196 to 9 per encoder. Tokens enter a 12-layer causal transformer with hidden size 384 and time embeddings. Distinct query types request pose, global Exo, future frame Exo and an auxiliary future Ego image. Avoid overloading the audience with every dimension.", "source": "\u00a73.2\u20133.3; \u00a74.1.3", "el": [{"type": "text", "v": "Multimodal tokens and queries", "x": 64, "y": 57, "w": 1150, "h": 110, "size": 50, "color": "#171B1E", "bold": true}, {"type": "text", "v": "06", "x": 1168, "y": 668, "w": 65, "h": 28, "size": 18, "color": "#72787C", "bold": false}, {"type": "text", "v": "\u00a73.2\u20133.3; \u00a74.1.3", "x": 64, "y": 670, "w": 1060, "h": 25, "size": 15, "color": "#72787C", "bold": false}, {"type": "text", "v": "Encode each modality", "x": 68, "y": 205, "w": 1120, "h": 38, "size": 29, "color": "#2D5263", "bold": true}, {"type": "text", "v": "CLIP text \u00b7 MAE + DINOv2 images \u00b7 HandFormer poses", "x": 68, "y": 248, "w": 1120, "h": 70, "size": 25, "color": "#171B1E", "bold": false}, {"type": "text", "v": "Fuse through causal attention", "x": 68, "y": 342, "w": 1120, "h": 38, "size": 29, "color": "#2D5263", "bold": true}, {"type": "text", "v": "12 transformer layers \u00b7 hidden size 384 \u00b7 time embeddings", "x": 68, "y": 385, "w": 1120, "h": 70, "size": 25, "color": "#171B1E", "bold": false}, {"type": "text", "v": "Decode distinct query types", "x": 68, "y": 479, "w": 1120, "h": 38, "size": 29, "color": "#2D5263", "bold": true}, {"type": "text", "v": "Future poses \u00b7 global Exo \u00b7 frame-level Exo \u00b7 auxiliary Ego image", "x": 68, "y": 522, "w": 1120, "h": 70, "size": 25, "color": "#171B1E", "bold": false}]}]